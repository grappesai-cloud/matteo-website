---
import Layout from '../../layouts/Layout.astro';
import CartDrawer from '../../components/CartDrawer.astro';
import { catalogArtists, SIZES, formatPrice, activeProducts, effectivePrice, compareAtPrice, isSoldOut } from '../../lib/products';
import { readCatalog } from '../../lib/catalog-store';
import { readArtistMeta } from '../../lib/artists-store';

export const prerender = false;

const [products, artistMeta] = await Promise.all([
  readCatalog().then(activeProducts),
  readArtistMeta(),
]);
const artistsWithCounts = catalogArtists(products, artistMeta).map((a) => ({
  ...a,
  count: products.filter((p) => p.artist === a.slug).length,
}));
---

<Layout
  title="Shop · Mattman Music"
  description="Merch oficial Mattman Music: tricouri oversized cu print pe față și pe spate, ediție limitată."
>
  <div class="merch">
    <header class="m-header">
      <a href="/" class="m-brand">
        <img src="/images/mattman/logo-head.webp" alt="Mattman Music" class="m-brand-logo" width="320" height="291" decoding="async" />
      </a>
      <nav class="m-nav mono">
        <a href="/" class="m-back">← Site</a>
        <button class="m-cart" type="button" data-cart-open aria-label="Deschide coșul">
          Coș<span class="m-cart-badge" data-cart-count data-empty="1">0</span>
        </button>
      </nav>
    </header>

    <section class="m-hero">
      <p class="mono dim m-eyebrow">Mattman Shop · ediție limitată</p>
      <h1 class="m-title">Merch</h1>
      <p class="m-lede" id="m-lede" data-default="Tricouri oversized cu print pe față și pe spate, în ediție limitată.">
        Tricouri oversized cu print pe față și pe spate, în ediție limitată.
      </p>
    </section>

    <section class="m-filters" aria-label="Filtre">
      <div class="m-filter-group">
        <span class="m-filter-label mono dim">Artist</span>
        <div class="m-chips" id="artist-chips" role="group">
          <button class="m-chip is-active" data-artist="all" type="button">Toți</button>
          {artistsWithCounts.map((a) => (
            <button class="m-chip" data-artist={a.slug} data-name={a.name} data-soon={a.count === 0 ? '1' : ''} type="button">
              {a.name}
              {a.count === 0 && <span class="m-chip-soon mono">în curând</span>}
            </button>
          ))}
        </div>
      </div>

      <div class="m-filter-group">
        <span class="m-filter-label mono dim">Mărime</span>
        <div class="m-chips" id="size-chips" role="group">
          <button class="m-chip m-chip-sm is-active" data-size="all" type="button">Toate</button>
          {SIZES.map((s) => (
            <button class="m-chip m-chip-sm" data-size={s} type="button">{s}</button>
          ))}
        </div>
      </div>
    </section>

    <section class="m-grid" id="m-grid" aria-label="Produse">
      {products.map((p) => {
        const c = p.colors[0];
        return (
          <a
            href={`/merch/${p.slug}`}
            class="pc"
            data-artist={p.artist}
            data-sizes={p.sizes.join(',')}
          >
            <div class="pc-media">
              <img class="pc-img pc-front" src={c.front} alt={p.name} loading="lazy" decoding="async" width="2400" height="3000" />
              {p.badge && <span class="pc-badge mono">{p.badge}</span>}
              {p.discountPercent ? <span class="pc-sale mono">−{p.discountPercent}%</span> : null}
              {isSoldOut(p) && <span class="pc-soldout mono">Stoc epuizat</span>}
            </div>
            <div class="pc-info">
              <div class="pc-text">
                <h2 class="pc-name">{p.name}</h2>
                <p class="pc-sub mono dim">{p.subtitle}</p>
                {p.colors.length > 1 && (
                  <span class="pc-colors" aria-hidden="true">
                    {p.colors.map((col) => <span class="pc-dot" style={`--c:${col.swatch}`}></span>)}
                  </span>
                )}
              </div>
              <span class="pc-price">
                {compareAtPrice(p) && <s class="pc-was">{formatPrice(compareAtPrice(p)!)}</s>}
                {formatPrice(effectivePrice(p))}
              </span>
            </div>
          </a>
        );
      })}
    </section>

    <div class="m-empty" id="m-empty" hidden>
      <p class="m-empty-title">În curând</p>
      <p class="m-empty-sub mono dim">Merch-ul acestui artist nu e încă disponibil. Revino curând.</p>
    </div>

    <footer class="m-foot mono">
      <span>© {new Date().getFullYear()} Mattman Music</span>
      <a href="https://grappes.dev" target="_blank" rel="noopener" style="font-size:11px;letter-spacing:0.04em;opacity:0.6">made by grappes</a>
    </footer>
  </div>

  <CartDrawer products={products} />

  <script>
    const grid = document.getElementById('m-grid')!;
    const empty = document.getElementById('m-empty') as HTMLElement;
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.pc'));
    let activeArtist = 'all';
    let activeSize = 'all';

    function apply() {
      let shown = 0;
      cards.forEach((card) => {
        const artistOk = activeArtist === 'all' || card.dataset.artist === activeArtist;
        const sizeOk = activeSize === 'all' || (card.dataset.sizes || '').split(',').includes(activeSize);
        const visible = artistOk && sizeOk;
        card.style.display = visible ? '' : 'none';
        if (visible) shown++;
      });
      empty.hidden = shown > 0;
      grid.style.display = shown > 0 ? '' : 'none';
    }

    const ledeEl = document.getElementById('m-lede') as HTMLElement;
    const defaultLede = ledeEl?.dataset.default || '';
    function updateLede(btn: HTMLElement) {
      if (!ledeEl) return;
      if (btn.dataset.artist === 'all') { ledeEl.textContent = defaultLede; return; }
      const name = btn.dataset.name || '';
      ledeEl.textContent = btn.dataset.soon
        ? `${name}: merch în curând.`
        : `${name}: tricouri oversized cu print pe față și pe spate, în ediție limitată.`;
    }

    document.getElementById('artist-chips')!.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-artist]');
      if (!btn) return;
      activeArtist = btn.dataset.artist!;
      document.querySelectorAll('#artist-chips .m-chip').forEach((c) => c.classList.toggle('is-active', c === btn));
      updateLede(btn);
      apply();
    });
    document.getElementById('size-chips')!.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-size]');
      if (!btn) return;
      activeSize = btn.dataset.size!;
      document.querySelectorAll('#size-chips .m-chip').forEach((c) => c.classList.toggle('is-active', c === btn));
      apply();
    });
  </script>

  <style>
    :global(.grain), :global(.cursor) { display: none !important; }

    .merch {
      min-height: 100vh;
      padding: clamp(16px, 2.2vw, 32px);
      display: flex;
      flex-direction: column;
      gap: clamp(28px, 4vw, 56px);
      background: var(--ink, #0a0a0a);
      color: var(--cream, #f2ebe0);
    }

    /* HEADER */
    .m-header { display: flex; align-items: center; justify-content: space-between; }
    .m-brand-logo {
      height: clamp(26px, 3.4vw, 36px);
      width: auto;
      filter: invert(1) brightness(1) sepia(0.1);
      opacity: 0.95;
    }
    .m-nav { display: flex; align-items: center; gap: clamp(16px, 2vw, 28px); }
    .m-back { color: var(--dim, rgba(242,235,224,0.55)); letter-spacing: 0.1em; transition: color 0.2s; }
    .m-back:hover { color: var(--gold, #c9a24a); }
    .m-cart {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 9px 16px;
      border: 1px solid var(--hair-strong, rgba(242,235,224,0.32));
      border-radius: 999px;
      color: var(--cream, #f2ebe0);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      transition: background 0.2s, color 0.2s;
    }
    .m-cart:hover { background: var(--cream, #f2ebe0); color: var(--ink, #0a0a0a); }
    .m-cart-badge {
      min-width: 18px; height: 18px; padding: 0 5px;
      border-radius: 999px;
      background: var(--gold, #c9a24a);
      color: var(--ink, #0a0a0a);
      font-size: 10px;
      display: inline-grid; place-items: center;
      transition: opacity 0.2s, transform 0.2s;
    }
    .m-cart-badge[data-empty="1"] { opacity: 0; transform: scale(0.6); }
    .m-cart:hover .m-cart-badge { background: var(--ink, #0a0a0a); color: var(--gold, #c9a24a); }

    /* HERO */
    .m-hero { max-width: 60ch; }
    .m-eyebrow { letter-spacing: 0.18em; }
    .m-title {
      font-family: var(--serif, 'Fraunces', serif);
      font-weight: 400;
      font-size: clamp(56px, 13vw, 168px);
      line-height: 0.86;
      letter-spacing: -0.03em;
      margin: 10px 0 18px;
    }
    .m-lede { font-size: clamp(15px, 1.4vw, 18px); line-height: 1.6; color: rgba(242,235,224,0.78); max-width: 52ch; }
    .m-lede strong { color: var(--cream, #f2ebe0); font-weight: 600; }

    /* FILTERS */
    .m-filters { display: flex; flex-wrap: wrap; gap: clamp(18px, 3vw, 40px); align-items: flex-start; }
    .m-filter-group { display: flex; flex-direction: column; gap: 10px; }
    .m-filter-label { letter-spacing: 0.16em; }
    .m-chips { display: flex; flex-wrap: wrap; gap: 8px; }
    .m-chip {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 9px 16px;
      border: 1px solid var(--hair-strong, rgba(242,235,224,0.32));
      border-radius: 999px;
      background: transparent;
      color: var(--cream, #f2ebe0);
      font-size: 13px;
      cursor: pointer;
      transition: background 0.2s, color 0.2s, border-color 0.2s;
    }
    .m-chip:hover { border-color: var(--cream, #f2ebe0); }
    .m-chip.is-active { background: var(--gold, #c9a24a); color: var(--ink, #0a0a0a); border-color: var(--gold, #c9a24a); }
    .m-chip-sm { padding: 8px 14px; font-family: var(--mono, monospace); font-size: 12px; }
    .m-chip-soon {
      font-size: 9px; letter-spacing: 0.1em; text-transform: uppercase;
      padding: 2px 6px; border-radius: 999px;
      background: rgba(242,235,224,0.1);
      color: var(--dim, rgba(242,235,224,0.55));
    }
    .m-chip.is-active .m-chip-soon { background: rgba(10,10,10,0.18); color: rgba(10,10,10,0.7); }

    /* GRID */
    .m-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: clamp(14px, 2vw, 28px);
    }
    .pc {
      display: flex;
      flex-direction: column;
      gap: 14px;
      color: inherit;
      text-decoration: none;
    }
    .pc-media {
      position: relative;
      aspect-ratio: 4 / 5;
      border: 1px solid var(--hair, rgba(242,235,224,0.14));
      border-radius: 5px;
      overflow: hidden;
      background: #131313;
      transition: border-color 0.3s ease;
    }
    .pc-img {
      position: absolute; inset: clamp(7px, 1vw, 13px);
      width: auto; height: auto;
      object-fit: cover;
      transition: transform 1.1s cubic-bezier(0.2,0.7,0.2,1);
    }
    @media (hover: hover) {
      .pc:hover .pc-media { border-color: var(--gold, #c9a24a); }
      .pc:hover .pc-img { transform: scale(1.03); }
    }
    .pc-badge {
      position: absolute; top: 12px; left: 12px;
      padding: 5px 10px;
      background: var(--gold, #c9a24a);
      color: var(--ink, #0a0a0a);
      border-radius: 999px;
      font-size: 10px; letter-spacing: 0.1em;
    }
    .pc-sale {
      position: absolute; top: 12px; right: 12px;
      padding: 5px 10px; border-radius: 999px;
      background: #b3261e; color: #fff;
      font-size: 10px; letter-spacing: 0.06em;
    }
    .pc-soldout {
      position: absolute; inset: 0; display: grid; place-items: center;
      background: rgba(10,10,10,0.55);
      color: var(--cream, #f2ebe0); letter-spacing: 0.15em; font-size: 12px;
      backdrop-filter: grayscale(1);
    }
    .pc-was { color: var(--dim, rgba(242,235,224,0.55)); text-decoration: line-through; margin-right: 8px; }
    .pc-colors {
      display: flex; gap: 7px;
      margin-top: 9px;
    }
    .pc-dot {
      width: 14px; height: 14px; border-radius: 999px;
      background: var(--c);
      border: 1.5px solid rgba(242,235,224,0.55);
    }
    .pc-info { display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; }
    .pc-name {
      font-family: var(--serif, 'Fraunces', serif);
      font-weight: 400;
      font-size: clamp(19px, 1.9vw, 25px);
      line-height: 1.05;
      letter-spacing: -0.01em;
      margin: 0 0 4px;
    }
    .pc-sub { letter-spacing: 0.06em; }
    .pc-price {
      font-family: var(--mono, monospace);
      font-size: 14px;
      white-space: nowrap;
      padding-top: 2px;
    }

    /* EMPTY */
    .m-empty { padding: clamp(40px, 8vw, 90px) 0; text-align: center; }
    .m-empty-title { font-family: var(--serif, 'Fraunces', serif); font-size: clamp(36px, 6vw, 64px); margin: 0 0 10px; }
    .m-empty-sub { letter-spacing: 0.08em; }

    /* FOOTER */
    .m-foot {
      margin-top: auto;
      display: flex; justify-content: space-between; align-items: center; gap: 16px;
      padding-top: 24px;
      border-top: 1px solid var(--hair, rgba(242,235,224,0.14));
      color: var(--dim, rgba(242,235,224,0.55));
    }
    .m-foot a { color: inherit; transition: color 0.2s; }
    .m-foot a:hover { color: var(--gold, #c9a24a); }

    @media (max-width: 880px) {
      .m-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 460px) {
      .m-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
      .pc-name { font-size: 16px; }
      .pc-price { font-size: 12px; }
    }
  </style>
</Layout>
