# === Stripe — checkout pe /merch + coduri de reducere ===
# https://dashboard.stripe.com/apikeys  (test: sk_test_... · prod: sk_live_...)
STRIPE_SECRET_KEY=sk_test_xxx
# Webhook pt. scăderea automată a stocului la comandă plătită.
# Stripe Dashboard → Developers → Webhooks → endpoint /api/stripe-webhook,
# eveniment checkout.session.completed → copiază "Signing secret" (whsec_...).
STRIPE_WEBHOOK_SECRET=whsec_xxx

# === Admin (/admin) — două roluri, două parole ===
# admin = acces complet (produse, landing, coduri, raport comenzi)
ADMIN_PASSWORD=schimba-ma
# ruvix = firma de tricouri — vede DOAR comenzile (status + AWB), nu poate edita site-ul
RUVIX_PASSWORD=schimba-ma-ruvix

# === FAN Courier — generare AWB din dashboard (opțional) ===
# Self-AWB API v2.0 (api.fancourier.ro). Când toate 3 sunt setate, butonul
# „Generează AWB FAN" e activ; altfel curierul/AWB se completează manual.
FAN_USERNAME=
FAN_PASSWORD=
FAN_CLIENT_ID=

# === Notificare email Ruvix la comandă nouă (opțional, Resend) ===
# https://resend.com → API key. NOTIFY_FROM trebuie să fie pe un domeniu
# verificat în Resend (altfel folosește expeditorul de test onboarding@resend.dev).
# RUVIX_EMAIL = adresa (sau adrese separate prin virgulă) unde primesc comenzile.
RESEND_API_KEY=
RUVIX_EMAIL=
NOTIFY_FROM=Mattman Music <comenzi@mattmanmusic.com>

# === Vercel Blob — stocarea catalogului + pozele din admin ===
# Creează un Blob store în Vercel → Storage; tokenul se injectează automat în
# producție. Pentru local: `vercel env pull` sau lipește tokenul aici.
BLOB_READ_WRITE_TOKEN=
