---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Comandă confirmată — Mattman Shop" description="Mulțumim pentru comandă.">
  <div class="ok">
    <header class="m-header">
      <a href="/merch" class="m-brand">
        <img src="/images/mattman/logo-black.png" alt="Mattman Music" class="m-brand-logo" />
      </a>
      <a href="/merch" class="m-back mono">← Shop</a>
    </header>

    <main class="ok-main">
      <span class="ok-check" aria-hidden="true">✓</span>
      <p class="mono dim ok-eyebrow">Plată confirmată</p>
      <h1 class="ok-title">Mulțumim!</h1>
      <p class="ok-lede">
        Comanda ta a fost înregistrată. Vei primi un e-mail de confirmare cu detaliile
        și statusul livrării. Tricourile pleacă spre tine în 2–5 zile lucrătoare.
      </p>
      <p class="ok-ref mono dim" id="ok-ref" hidden></p>
      <div class="ok-actions">
        <a href="/merch" class="ok-btn">Înapoi la shop</a>
        <a href="/" class="ok-btn ok-btn-ghost">Pagina principală</a>
      </div>
    </main>

    <footer class="m-foot mono">
      <span>© {new Date().getFullYear()} Mattman Music</span>
      <a href="mailto:hello@mattmanmusic.com">hello@mattmanmusic.com</a>
    </footer>
  </div>

  <script>
    // Order placed — empty the cart.
    try { localStorage.removeItem('mattman_cart'); } catch {}
    const sid = new URLSearchParams(location.search).get('session_id');
    if (sid) {
      const el = document.getElementById('ok-ref')!;
      el.textContent = `Referință comandă: ${sid.slice(-12)}`;
      el.hidden = false;
      // Best-effort: make sure the order is recorded (idempotent) even if the
      // Stripe webhook is delayed. Shows the friendly order number when ready.
      fetch(`/api/order-from-session?session_id=${encodeURIComponent(sid)}`)
        .then((r) => r.json())
        .then((d) => { if (d?.ok && d.number) el.textContent = `Comanda #${d.number}`; })
        .catch(() => {});
    }
  </script>

  <style>
    :global(.grain), :global(.cursor) { display: none !important; }
    .ok {
      min-height: 100vh; padding: clamp(16px, 2.2vw, 32px);
      display: flex; flex-direction: column;
      background: var(--ink, #0a0a0a); color: var(--cream, #f2ebe0);
    }
    .m-header { display: flex; align-items: center; justify-content: space-between; }
    .m-brand-logo { height: clamp(26px, 3.4vw, 36px); width: auto; filter: invert(1) brightness(1) sepia(0.1); opacity: 0.95; }
    .m-back { color: var(--dim, rgba(242,235,224,0.55)); letter-spacing: 0.1em; transition: color 0.2s; }
    .m-back:hover { color: var(--gold, #c9a24a); }

    .ok-main {
      flex: 1 1 auto; display: flex; flex-direction: column; align-items: center; justify-content: center;
      text-align: center; gap: 10px; max-width: 56ch; margin: 0 auto; padding: 40px 0;
    }
    .ok-check {
      width: 64px; height: 64px; border-radius: 999px;
      display: grid; place-items: center; font-size: 30px;
      background: var(--gold, #c9a24a); color: var(--ink, #0a0a0a);
      margin-bottom: 14px;
    }
    .ok-eyebrow { letter-spacing: 0.18em; }
    .ok-title { font-family: var(--serif, 'Fraunces', serif); font-weight: 400; font-size: clamp(48px, 9vw, 100px); line-height: 0.9; margin: 6px 0 14px; }
    .ok-lede { font-size: clamp(15px, 1.3vw, 17px); line-height: 1.7; color: rgba(242,235,224,0.8); }
    .ok-ref { margin-top: 16px; letter-spacing: 0.08em; }
    .ok-actions { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; margin-top: 30px; }
    .ok-btn {
      padding: 14px 26px; border-radius: 999px;
      background: var(--gold, #c9a24a); color: var(--ink, #0a0a0a);
      font-family: var(--mono, monospace); text-transform: uppercase; letter-spacing: 0.14em; font-size: 12px;
      transition: background 0.2s;
    }
    .ok-btn:hover { background: var(--gold-bright, #e8c16c); }
    .ok-btn-ghost { background: transparent; color: var(--cream, #f2ebe0); border: 1px solid var(--hair-strong, rgba(242,235,224,0.32)); }
    .ok-btn-ghost:hover { background: var(--cream, #f2ebe0); color: var(--ink, #0a0a0a); }

    .m-foot {
      display: flex; justify-content: space-between; align-items: center; gap: 16px;
      padding-top: 24px; border-top: 1px solid var(--hair, rgba(242,235,224,0.14));
      color: var(--dim, rgba(242,235,224,0.55));
    }
    .m-foot a { color: inherit; transition: color 0.2s; }
    .m-foot a:hover { color: var(--gold, #c9a24a); }
  </style>
</Layout>
