# === Stripe — checkout pe /merch + coduri de reducere ===
# https://dashboard.stripe.com/apikeys  (test: sk_test_... · prod: sk_live_...)
STRIPE_SECRET_KEY=sk_test_xxx
# Webhook pt. scăderea automată a stocului la comandă plătită.
# Stripe Dashboard → Developers → Webhooks → endpoint /api/stripe-webhook,
# eveniment checkout.session.completed → copiază "Signing secret" (whsec_...).
STRIPE_WEBHOOK_SECRET=whsec_xxx

# === Admin (/admin) — o parolă comună pentru echipă ===
ADMIN_PASSWORD=schimba-ma

# === Vercel Blob — stocarea catalogului + pozele din admin ===
# Creează un Blob store în Vercel → Storage; tokenul se injectează automat în
# producție. Pentru local: `vercel env pull` sau lipește tokenul aici.
BLOB_READ_WRITE_TOKEN=
